{
  "name": "@cffnpwr/textlint-plugin-comments",
  "version": "1.0.0",
  "description": "ソースコード・設定ファイルのコメント部分だけをtextlintの検査対象にするプラグイン",
  "homepage": "https://github.com/cffnpwr/textlint-plugin-comments",
  "bugs": "https://github.com/cffnpwr/textlint-plugin-comments/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/cffnpwr/textlint-plugin-comments.git",
    "directory": "packages/plugin-comments"
  },
  "license": "MIT",
  "author": "cffnpwr",
  "type": "module",
  "keywords": [
    "textlintplugin"
  ],
  "files": [
    "dist",
    "wasm",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ts-pattern": "5.9.2",
    "web-tree-sitter": "0.27.1"
  },
  "devDependencies": {
    "@cffnpwr/textlint-rule-sentence-per-line": "1.2.1",
    "@mswjs/interceptors": "0.45.10",
    "@textlint/ast-node-types": "15.8.0",
    "@textlint/ast-tester": "15.8.0",
    "@textlint/kernel": "15.8.0",
    "@textlint/types": "15.8.0",
    "@tree-sitter-grammars/tree-sitter-toml": "0.7.0",
    "@tree-sitter-grammars/tree-sitter-yaml": "0.7.1",
    "msw": "3.0.3",
    "tree-sitter-bash": "0.25.1",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-json": "0.24.8",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-typescript": "0.23.2"
  },
  "peerDependencies": {
    "textlint": ">=12.1.0 <16.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "inlinedDependencies": {
    "@textlint/ast-node-types": "15.8.0",
    "@textlint/types": "15.8.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  }
}
